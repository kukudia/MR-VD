#pragma kernel InitializeParticles
#pragma kernel UpdateParticles
#pragma target 4.5

#define THREAD_GROUP_SIZE 64
#define TWO_PI 6.28318530718

struct Particle
{
    float3 position;
    float size;
    float3 velocity;
    float seed;
    float4 color;
};

RWStructuredBuffer<Particle> _Particles;

int _ParticleCount;
float _DeltaTime;
float _SimulationTime;
float3 _CameraDelta;
float _VolumeRadius;
float _MinimumDistance;
float _BackgroundSpeed;
float _MotionSmoothing;
float _Bass;
float _Synth;
float _Energy;
float4 _BackgroundColor;
float4 _AccentColor;
Texture2D<float4> _Gradient;
SamplerState sampler_Gradient;
float _GradientSpeed;
float _FormationBlend;
float _TorusBlend;
float _FormationRadius;
float _FormationThickness;
float _FormationAttraction;
float _FormationRotationSpeed;
float3 _FormationCenter;
float3 _FormationRight;
float3 _FormationUp;
float3 _FormationForward;
float _UseSpatialPalette;
float4 _SpatialPrimary;
float4 _SpatialSecondary;
float _FormationDetail;
float4 _SpectralShape;

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352d;
    value ^= value >> 15;
    value *= 0x846ca68b;
    value ^= value >> 16;
    return value;
}

float Random01(uint value)
{
    return (Hash(value) & 0x00ffffff) / 16777216.0;
}

float3 RandomDirection(uint value)
{
    float z = Random01(value) * 2.0 - 1.0;
    float angle = Random01(value + 17u) * TWO_PI;
    float radius = sqrt(max(0.0, 1.0 - z * z));
    return float3(cos(angle) * radius, sin(angle) * radius, z);
}

float3 RandomVolumePosition(uint index)
{
    float3 direction = RandomDirection(index * 37u + 11u);
    float radiusT = pow(Random01(index * 41u + 13u), 0.3333333);
    float radius = lerp(_MinimumDistance, _VolumeRadius * 0.98, radiusT);
    return direction * radius;
}

void InitializeParticle(uint index, inout Particle particle)
{
    particle.position = RandomVolumePosition(index);
    particle.velocity = RandomDirection(index * 47u + 19u)
        * _BackgroundSpeed
        * lerp(0.35, 1.0, Random01(index * 53u + 23u));
    particle.size = lerp(0.55, 1.35, Random01(index * 59u + 29u));
    particle.seed = Random01(index * 67u + 31u);
    particle.color = _BackgroundColor;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void InitializeParticles(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCount)
    {
        return;
    }

    Particle particle;
    InitializeParticle(index, particle);
    _Particles[index] = particle;
}

float3 FormationTarget(uint index, float seed)
{
    float radius = _FormationRadius * (0.85 + _Bass * 0.15);
    float orbit = _SimulationTime * _FormationRotationSpeed;
    float arm = (index % 3u) / 3.0 * TWO_PI;
    float distanceT = sqrt(Random01(index * 73u + 7u));
    float angle = arm + distanceT * 5.0 + orbit;
    float scatter = (seed - 0.5) * _FormationThickness;
    float3 galaxy = float3(cos(angle) * distanceT, scatter * 0.55, sin(angle) * distanceT) * radius;
    float majorAngle = seed * TWO_PI + orbit;
    float minorAngle = Random01(index * 79u + 3u) * TWO_PI + orbit * 0.7;
    float tube = _FormationThickness * (0.65 + _Synth * 0.2);
    float3 torus = float3((0.7 + tube * cos(minorAngle)) * cos(majorAngle),
        tube * sin(minorAngle), (0.7 + tube * cos(minorAngle)) * sin(majorAngle)) * radius;
    // Each particle keeps a stable population/strand identity. Differential orbital motion,
    // sparse halo dust and braided lanes create depth without stochastic frame-to-frame jitter.
    float population = Random01(index * 83u + 19u);
    float lane = floor(Random01(index * 89u + 23u) * 5.0);
    float filament = sin(distanceT * 21.0 + lane * 1.2566 + orbit * 1.7);
    float spiralAngle = angle + (lane - 2.0) * 0.065
        + sin(distanceT * 13.0 - orbit * 0.4 + lane) * 0.045;
    float spiralRadius = distanceT * (1.0 + filament * 0.025);
    float height = scatter * 0.3 + sin(distanceT * 12.0 + lane + orbit) * tube * 0.22;
    float3 detailedGalaxy = float3(cos(spiralAngle) * spiralRadius, height,
        sin(spiralAngle) * spiralRadius) * radius;
    if (population > 0.88)
    {
        float3 halo = RandomDirection(index * 97u + 29u);
        detailedGalaxy = float3(halo.x, halo.y * 0.42, halo.z) * radius * (0.35 + distanceT * 0.7);
    }
    float braid = majorAngle * 3.0 + lane * 1.2566 + orbit * (0.3 + _SpectralShape.x * 0.3);
    float braidTube = tube * (0.6 + lane * 0.13 + _SpectralShape.y * 0.18);
    float3 detailedTorus = float3((0.7 + braidTube * cos(braid)) * cos(majorAngle),
        braidTube * sin(braid), (0.7 + braidTube * cos(braid)) * sin(majorAngle)) * radius;
    galaxy = lerp(galaxy, detailedGalaxy, _FormationDetail);
    torus = lerp(torus, detailedTorus, _FormationDetail);
    float3 local = lerp(galaxy, torus, _TorusBlend);
    return _FormationCenter + _FormationRight * local.x + _FormationUp * local.y + _FormationForward * local.z;
}

void UpdateParticle(uint index, inout Particle particle)
{
    // Keep the simulated stars world-stable while the camera-centered volume follows the camera.
    particle.position -= _CameraDelta;

    float3 curl = float3(
        sin(_SimulationTime * 0.31 + particle.position.y * 1.7 + particle.seed * TWO_PI),
        cos(_SimulationTime * 0.27 + particle.position.x * 1.3),
        sin(_SimulationTime * 0.23 + particle.position.x - particle.position.y));
    float3 targetVelocity = normalize(curl + 0.001) * _BackgroundSpeed
        * (0.72 + _Synth * 1.35 + _Bass * 0.35);
    if (_FormationBlend > 0.001)
    {
        float3 attraction = (FormationTarget(index, particle.seed) - particle.position) * _FormationAttraction;
        // Bound displacement during transitions and preserve near-eye clearance below.
        attraction *= min(1.0, 2.0 / max(length(attraction), 0.001));
        targetVelocity = lerp(targetVelocity, attraction, _FormationBlend);
    }
    float response = 1.0 - exp(-_DeltaTime * _MotionSmoothing);
    particle.velocity = lerp(particle.velocity, targetVelocity, response);
    particle.position += particle.velocity * _DeltaTime;

    float distanceFromCenter = length(particle.position);
    if (distanceFromCenter > _VolumeRadius)
    {
        float3 direction = particle.position / max(distanceFromCenter, 0.0001);
        particle.position = -direction * (_VolumeRadius * 0.96);
    }
    else if (distanceFromCenter < _MinimumDistance)
    {
        float3 direction = normalize(particle.position + float3(0.001, 0.002, 0.003));
        particle.position = direction * _MinimumDistance;
    }

    float twinkle = sin(_SimulationTime * lerp(1.2, 4.2, particle.seed)
        + particle.seed * 31.0) * 0.5 + 0.5;
    float responseLevel = 0.42 + twinkle * 0.30 + _Energy * 0.28;
    float population = Random01(index * 83u + 19u);
    float hot = step(0.965, population);
    float detailBlend = _FormationBlend * _FormationDetail;
    // Mostly fine dust with a few larger luminous nodes, not uniformly sized dots.
    float microSize = lerp(0.38, 0.95, Random01(index * 101u + 37u)) + hot * 0.85;
    particle.size = lerp(lerp(0.55, 1.35, Random01(index * 59u + 29u)), microSize, detailBlend);
    responseLevel *= lerp(1.0, 0.65 + hot * 1.2 + _SpectralShape.w * twinkle * 0.5, detailBlend);
    // Ping-pong avoids a visible jump between the ends of an authored gradient.
    float phase = particle.seed + _SimulationTime * _GradientSpeed + _Synth * 0.08;
    float gradientT = 1.0 - abs(frac(phase * 0.5) * 2.0 - 1.0);
    float4 color = _Gradient.SampleLevel(sampler_Gradient, float2(gradientT, 0.5), 0);
    color.rgb = lerp(color.rgb, lerp(_SpatialPrimary.rgb, _SpatialSecondary.rgb, gradientT), _UseSpatialPalette);
    color.rgb = lerp(color.rgb, max(color.rgb, 0.75), hot * detailBlend * 0.65);
    // Store unattenuated RGB. Alpha is applied once by the additive shader.
    particle.color = float4(color.rgb, color.a * responseLevel);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void UpdateParticles(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCount)
    {
        return;
    }

    Particle particle = _Particles[index];
    UpdateParticle(index, particle);
    _Particles[index] = particle;
}
